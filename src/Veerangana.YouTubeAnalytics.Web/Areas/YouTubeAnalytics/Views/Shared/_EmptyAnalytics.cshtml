@model DashboardShellViewModel

<section class="tool-panel empty-state" role="status">
    <span class="empty-state__icon" aria-hidden="true"><i class="fa fa-bar-chart"></i></span>
    <h2>No analytics data available</h2>
    <p>Adjust the selected filters or refresh after the next data sync.</p>
    <button class="btn btn-primary js-refresh-page" type="button">
        <i class="fa fa-refresh" aria-hidden="true"></i>
        Refresh data
    </button>
</section>
