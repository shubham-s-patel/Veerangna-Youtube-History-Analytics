@model OverviewDashboardViewModel
@using System.Web.Helpers

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <section class="tool-panel analytics-message analytics-message--error" role="alert">
        <span class="analytics-message__icon"><i class="fa fa-exclamation-circle" aria-hidden="true"></i></span>
        <div>
            <h2>Analytics unavailable</h2>
            <p>@Model.ErrorMessage</p>
            <a class="btn btn-primary js-preserve-filters" href="@Url.Action("Index", "Settings", new { area = "YouTubeAnalytics" })">
                <i class="fa fa-database" aria-hidden="true"></i> Data sources
            </a>
        </div>
    </section>
}
else if (!Model.HasData)
{
    <section class="tool-panel empty-state">
        <span class="empty-state__icon"><i class="fa fa-line-chart" aria-hidden="true"></i></span>
        <h2>No analytics for this period</h2>
        <p>Choose another date range or remove filters to inspect the video library.</p>
        <a class="btn btn-primary" href="@Url.Action("Index")">Reset filters</a>
    </section>
}
else
{
    <section class="kpi-grid" aria-label="Video usage indicators">
        @foreach (MetricCardViewModel metric in Model.Metrics)
        {
            <article class="kpi-card">
                <div class="kpi-card__header">
                    <span class="metric-icon @metric.AccentCssClass"><i class="@metric.IconCssClass" aria-hidden="true"></i></span>
                    <span class="metric-menu" data-toggle="tooltip" title="@metric.Tooltip"><i class="fa fa-info-circle" aria-hidden="true"></i></span>
                </div>
                <span class="kpi-card__label">@metric.Label</span>
                <strong class="kpi-card__value">@metric.Value</strong>
                <span class="metric-change @metric.ComparisonCssClass">@metric.ComparisonText</span>
            </article>
        }
    </section>

    <section class="analytics-grid analytics-grid--primary">
        <article class="tool-panel performance-panel">
            <header class="tool-panel__header">
                <div>
                    <span class="section-kicker">Consumption</span>
                    <h2>Viewing behavior over time</h2>
                    <span class="panel-period">@Model.PeriodLabel</span>
                </div>
                <div class="panel-legend" aria-hidden="true">
                    <span><i class="legend-dot legend-dot--primary"></i>Views</span>
                    <span><i class="legend-dot legend-dot--comparison"></i>Watch hours</span>
                </div>
            </header>
            @if (Model.Trend.Count > 0)
            {
                <div class="usage-chart">
                    <canvas id="usage-trend-chart" aria-label="Daily views and watch time" role="img"></canvas>
                </div>
                <script type="application/json" id="usage-trend-data">@Html.Raw(Json.Encode(Model.Trend))</script>
            }
            else
            {
                <div class="panel-empty"><i class="fa fa-area-chart" aria-hidden="true"></i><span>No daily activity in this period.</span></div>
            }
        </article>

        <aside class="tool-panel insight-panel">
            <header class="tool-panel__header">
                <div>
                    <span class="section-kicker">Analysis</span>
                    <h2>Usage insights</h2>
                </div>
                <span class="panel-badge">Automatic</span>
            </header>
            <div class="insight-list">
                @foreach (InsightViewModel insight in Model.Insights)
                {
                    <article class="insight-item">
                        <span class="insight-item__icon @insight.AccentCssClass"><i class="@insight.IconCssClass" aria-hidden="true"></i></span>
                        <div>
                            <h3>@insight.Title</h3>
                            <p>@insight.Description</p>
                        </div>
                    </article>
                }
            </div>
        </aside>
    </section>

    <section class="tool-panel table-panel">
        <header class="tool-panel__header">
            <div>
                <span class="section-kicker">Content</span>
                <h2>Videos driving attention</h2>
            </div>
            <a class="text-link js-preserve-filters" href="@Url.Action("Index", "Videos", new { area = "YouTubeAnalytics" })">
                View all <i class="fa fa-arrow-right" aria-hidden="true"></i>
            </a>
        </header>
        @if (Model.TopVideos.Count > 0)
        {
            <div class="table-responsive">
                <table class="analytics-table">
                    <thead>
                        <tr>
                            <th scope="col">Video</th>
                            <th scope="col">Views</th>
                            <th scope="col">Watch time</th>
                            <th scope="col">Likes</th>
                            <th scope="col">Audience gained</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (TopVideoViewModel video in Model.TopVideos)
                        {
                            <tr>
                                <td>
                                    <a class="video-cell" href="@("https://www.youtube.com/watch?v=" + video.Id)" target="_blank" rel="noopener noreferrer">
                                        <span class="video-thumbnail">
                                            <img src="@video.ThumbnailUrl" alt="" loading="lazy" />
                                            <small>@video.Duration</small>
                                        </span>
                                        <span class="video-cell__copy">
                                            <strong>@video.Title</strong>
                                            <small>Published @video.PublishedDate</small>
                                        </span>
                                    </a>
                                </td>
                                <td>@video.Views</td>
                                <td>@video.WatchTime</td>
                                <td>@video.Likes</td>
                                <td><span class="audience-gain">@video.AudienceGained</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="panel-empty panel-empty--compact"><i class="fa fa-film" aria-hidden="true"></i><span>No videos generated activity in this period.</span></div>
        }
    </section>
}

@section Scripts {
    <script src="@Url.Content("~/Scripts/vendor/Chart.min.js")"></script>
    <script src="@Url.Content("~/Scripts/overview-dashboard.js")"></script>
}
